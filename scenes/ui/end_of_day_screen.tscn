[node name="StayButton" type="Button" parent="ConfirmPanel/VBox/ButtonsHBox"]
layout_mode = 2
size_flags_horizontal = 3
text = "Stay"

[node name="SummaryPanel" type="PanelContainer" parent="."]
visible = false
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -220.0
offset_top = -110.0
offset_right = 220.0
offset_bottom = 110.0
