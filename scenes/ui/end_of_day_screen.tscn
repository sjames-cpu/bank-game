autowrap_mode = 2

[node name="ButtonsHBox" type="HBoxContainer" parent="ConfirmPanel/VBox"]
layout_mode = 2

[node name="GoHomeButton" type="Button" parent="ConfirmPanel/VBox/ButtonsHBox"]
