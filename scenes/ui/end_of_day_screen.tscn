[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/end_of_day_screen.gd" id="screen_script"]
[ext_resource type="Theme" path="res://themes/banking_theme.tres" id="banking_theme"]

[node name="EndOfDayScreen" type="Control"]
process_mode = 3
visible = false
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("banking_theme")
script = ExtResource("screen_script")

[node name="Backdrop" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.6)

[node name="ConfirmPanel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -180.0
offset_top = -60.0
offset_right = 180.0
offset_bottom = 60.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="ConfirmPanel"]
layout_mode = 2
theme_override_constants/separation = 10
alignment = 1

[node name="QuestionLabel" type="Label" parent="ConfirmPanel/VBox"]
layout_mode = 2
text = "Go home and end Day 1?"
horizontal_alignment = 1
autowrap_mode = 2

[node name="NoteLabel" type="Label" parent="ConfirmPanel/VBox"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "The rest of the day is skipped."
