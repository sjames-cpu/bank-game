[ext_resource type="Theme" path="res://themes/banking_theme.tres" id="banking_theme"]

[node name="CashOrdersScreen" type="Control"]
process_mode = 2
visible = false
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
