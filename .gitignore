# Godot 4+ specific ignores
.godot/
/android/

# Summer Engine local-only state (SummerGit, caches, locks)
.summer/local/

# Scratch/working files (drafts, generated previews) - not project source
/scratch/

# Reference/inspiration images (sprite sheets, layout mockups) - not shipped assets
/image and reference/

# gdUnit4 test reports (generated by every test run)
/reports/

# Written for one Godot run by run_tests.sh's warning check (tools/write_warnings_override.gd)
/override.cfg
